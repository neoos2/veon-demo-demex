---
import FutureLink from "../FutureLink.astro";
import Ticks from "../Ticks.astro";
import { categories, makes, FUTURE_NOTE } from "../../data/site";
const half = Math.ceil(categories.length / 2);
const colA = categories.slice(0, half);
const colB = categories.slice(half);
---
<section id="catalog" class="section catalog">
  <div class="container">
    <div class="catalog__head">
      <div><Ticks /><h2>Каталог запчастин</h2></div>
      <div class="tabs" role="tablist" aria-label="Як шукати" data-tabs>
        <button class="tabs__tab" type="button" role="tab" id="tab-cat" aria-controls="panel-cat" aria-selected="true">За категорією</button>
        <button class="tabs__tab" type="button" role="tab" id="tab-make" aria-controls="panel-make" aria-selected="false" tabindex="-1" data-rec="R-002">За маркою авто</button>
      </div>
    </div>

    <div class="catalog__panel is-shown" id="panel-cat" role="tabpanel" aria-labelledby="tab-cat" tabindex="0">
      <h3 class="catalog__nojs">За категорією</h3>
      <div class="index">
        {[colA, colB].map((col) => (
          <ul class="index__col">
            {col.map((c) => <li><FutureLink note={FUTURE_NOTE} class="index__item">{c}</FutureLink></li>)}
          </ul>
        ))}
      </div>
    </div>

    <div class="catalog__panel" id="panel-make" role="tabpanel" aria-labelledby="tab-make" tabindex="0" data-rec="R-002">
      <h3 class="catalog__nojs">За маркою авто</h3>
      <p class="catalog__note small">Модель і рік оберете на сторінці марки або надішліть VIN, і менеджер підбере сам.</p>
      <ul class="makes">
        {makes.map((m) => <li><FutureLink note={FUTURE_NOTE} class="make"><span class="make__name">{m}</span></FutureLink></li>)}
        <li><FutureLink note={FUTURE_NOTE} class="make make--all"><span class="make__name">Усі марки</span></FutureLink></li>
      </ul>
    </div>
  </div>
</section>

<script>
  const list = document.querySelector<HTMLElement>("[data-tabs]");
  if (list) {
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>("[role=tab]"));
    const select = (tab: HTMLButtonElement, focus = false) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute("aria-controls") ?? "");
        if (panel) {
          panel.classList.toggle("is-shown", on);
          if (on) { panel.classList.remove("is-entering"); void panel.offsetWidth; panel.classList.add("is-entering"); }
        }
      });
      if (focus) tab.focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(t));
      t.addEventListener("keydown", (e) => {
        const k = e.key;
        let n = -1;
        if (k === "ArrowRight") n = (i + 1) % tabs.length;
        else if (k === "ArrowLeft") n = (i - 1 + tabs.length) % tabs.length;
        else if (k === "Home") n = 0;
        else if (k === "End") n = tabs.length - 1;
        if (n >= 0) { e.preventDefault(); select(tabs[n]!, true); }
      });
    });
    select(tabs[0]!);
    document.querySelectorAll(".catalog__panel").forEach((p) => p.classList.remove("is-entering"));
  }
</script>

<style>
  .catalog__head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--s-3); margin-bottom: var(--s-4); }
  .tabs { display: none; gap: 4px; padding: 4px; background: var(--color-surface); border-radius: var(--radius); }
  :global(.js) .tabs { display: inline-flex; }
  .tabs__tab {
    min-height: var(--tap); padding: 0 var(--s-2); white-space: nowrap; border: 0; border-radius: var(--radius); cursor: pointer;
    font: var(--fw-semi) 1rem/1.2 var(--font-body); color: var(--color-text); background: transparent;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  @media (max-width: 479px) {
    :global(.js) .tabs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; }
    .tabs__tab { padding: 0 var(--s-1); font-size: 0.9375rem; }
  }
  .tabs__tab:hover { color: var(--color-accent-strong); }
  .tabs__tab[aria-selected="true"] { background: var(--color-bg); color: var(--color-accent-strong); box-shadow: inset 0 -2px 0 var(--color-accent); }

  .catalog__nojs { margin-bottom: var(--s-3); }
  :global(.js) .catalog__nojs { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .catalog__panel + .catalog__panel { margin-top: var(--s-5); }
  :global(.js) .catalog__panel:not(.is-shown) { display: none; }
  :global(.js) .catalog__panel + .catalog__panel { margin-top: 0; }
  .catalog__panel:focus-visible { outline-offset: 8px; }
  .catalog__panel.is-entering { animation: panel-in var(--dur-tab) var(--ease-out); }
  @keyframes panel-in { from { opacity: 0; transform: translateX(8px); } }
  @media (max-width: 767px) { @keyframes panel-in { from { opacity: 0; } } .catalog__panel.is-entering { animation-duration: 200ms; } }

  .index { display: grid; grid-template-columns: minmax(0, 1fr); column-gap: var(--gutter); }
  .index__col { display: grid; align-content: start; }
  .index__col li { border-top: 1px solid var(--color-line); }
  .index__col:last-child li:last-child { border-bottom: 1px solid var(--color-line); }
  .index :global(.index__item) {
    display: flex; width: 100%; min-height: 56px; padding-block: var(--s-2); align-items: center;
    font: var(--fw-semi) var(--fs-index)/1.15 var(--font-display); color: var(--color-text);
    text-decoration: none; overflow-wrap: break-word; min-width: 0;
    transition: color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .index :global(.index__item:hover) { color: var(--color-accent-strong); transform: translateX(4px); }
  @media (hover: hover) and (min-width: 768px) {
    .index :global(.index__item .future-link__note) { left: auto; right: 0; top: 50%; transform: translate(0, -50%); }
    .index :global(.index__item:hover .future-link__note), .index :global(.index__item:focus .future-link__note) { transform: translate(0, -50%); }
  }

  .catalog__note { color: var(--color-text-muted); margin-bottom: var(--s-3); max-width: 60ch; }
  .makes { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-1); }
  .makes :global(.make) {
    display: flex; align-items: flex-end; width: 100%; min-height: 72px; padding: var(--s-1) var(--s-1) var(--s-1) 12px;
    background: var(--color-surface); border-radius: var(--radius); text-decoration: none; color: var(--color-text);
    font: var(--fw-semi) 0.9375rem/1.15 var(--font-display); overflow-wrap: anywhere; min-width: 0;
    transition: background-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  .makes :global(.make:hover) { background: var(--color-brand); color: var(--color-accent-ink); }
  .makes :global(.make--all) { background: var(--color-ink); color: var(--color-white); }
  @media (hover: hover) and (min-width: 768px) { .makes :global(.make .future-link__note) { top: auto; bottom: calc(100% + 8px); } }

  @media (min-width: 768px) {
    .index { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .index__col li:last-child { border-bottom: 1px solid var(--color-line); }
    .makes { grid-template-columns: repeat(8, minmax(0, 1fr)); }
  }
  @media (min-width: 1200px) {
    .makes { grid-template-columns: repeat(17, minmax(0, 1fr)); gap: var(--gutter); }
    .makes :global(.make) { min-height: 200px; padding: var(--s-2) 0; justify-content: center; align-items: flex-end; font-size: 1.125rem; }
    .make__name { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; }
  }
  @media (prefers-reduced-motion: reduce) {
    .catalog__panel.is-entering { animation: none; }
    .index :global(.index__item:hover) { transform: none; }
  }
</style>
