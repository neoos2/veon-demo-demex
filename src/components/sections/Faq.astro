---
import { faq } from "../../data/faq";
import Ticks from "../Ticks.astro";
---
<section id="faq" class="section section--surface faq">
  <div class="container grid">
    <div class="section__head"><Ticks /><h2>Часті питання</h2></div>
    <div class="section__body faq__list">
      {faq.map((f) => (
        <details class="faq__item">
          <summary><h3 class="faq__q">{f.q}</h3><span class="faq__icon" aria-hidden="true"></span></summary>
          <p class="faq__a">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq .grid { row-gap: var(--s-4); }
  .faq__list { border-top: 1px solid var(--color-line-ui); }
  .faq__item { border-bottom: 1px solid var(--color-line-ui); }
  .faq__item summary { display: flex; align-items: center; justify-content: space-between; gap: var(--s-2); min-height: 64px; padding-block: var(--s-2); cursor: pointer; list-style: none; border-radius: var(--radius); }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__q { font-size: var(--fs-h3); transition: color var(--dur-fast) var(--ease-out); }
  .faq__item summary:hover .faq__q { color: var(--color-accent-strong); }
  .faq__icon { position: relative; flex: none; width: 24px; height: 24px; }
  .faq__icon::before, .faq__icon::after { content: ""; position: absolute; left: 4px; right: 4px; top: 11px; height: 2px; background: var(--color-accent); transition: transform var(--dur-fast) var(--ease-out); }
  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }
  .faq__a { padding-bottom: var(--s-3); color: var(--color-text-muted); max-width: 62ch; }
  @media (prefers-reduced-motion: reduce) { .faq__icon::before, .faq__icon::after { transition: none; } }
</style>
