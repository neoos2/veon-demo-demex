---
import Icon from "./Icon.astro";
import { mainPhone } from "../data/site";
---
<nav class="mbar on-brand" aria-label="Швидкий зв'язок" data-rec="R-012,R-016">
  <a class="mbar__item" href={`tel:${mainPhone.tel}`}><Icon name="phone" />Подзвонити</a>
  <a class="mbar__item mbar__item--main" href="#vin" data-vin-bar><Icon name="mail" />Надіслати VIN</a>
</nav>

<style>
  .mbar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-1); padding: var(--s-1) var(--s-1) calc(var(--s-1) + env(safe-area-inset-bottom)); background: var(--color-brand); }
  .mbar__item { display: flex; align-items: center; justify-content: center; gap: var(--s-1); min-height: var(--tap); border-radius: var(--radius); text-decoration: none; font-weight: var(--fw-semi); color: var(--color-white); transition: background-color var(--dur-fast) var(--ease-out); }
  .mbar__item:hover { background: var(--color-brand-dark); }
  .mbar__item--main { background: var(--color-white); color: var(--color-ink); }
  .mbar__item--main:hover { background: var(--color-surface); }
  .mbar__item :global(.icon) { width: 20px; height: 20px; }
  .mbar :global(:focus-visible) { outline-color: var(--color-focus-inverse); }
  @media (min-width: 768px) { .mbar { display: none; } }
</style>
