---
import Icon from "./Icon.astro";
import { mainPhone, vinMailto, partMailto, vinSegments } from "../data/site";

const H1 = "Автозапчастини для всіх марок — підберемо деталь за 17 знаками VIN";
const cells = Array.from({ length: 17 }, (_, i) => i + 1);
const segOf = (pos: number) => vinSegments.findIndex((s) => pos >= s.from && pos <= s.to);
// Phone ruler: WMI / VDS / VIS (3 / 6 / 8)
const groups = [
  { n: 3, label: "1–3 виробник" },
  { n: 6, label: "4–9 модель, кузов, двигун" },
  { n: 8, label: "10–17 рік, завод, серійний номер" },
];
let tick = 0;
---
<section id="hero" class="hero on-brand" data-rec="R-001,R-202">
  <div class="container grid hero__grid">
    <h1 class="hero__title">{H1}</h1>
    <p class="hero__lead">Менеджер перевірить застосовність, наявність, ціну і строки — до оплати. Оригінал і аналоги, понад 6&nbsp;000&nbsp;000 позицій.</p>

    <div class="vin" data-vin>
      <div class="vin__top">
        <label class="vin__label" for="vin-input">Ваш VIN-код <span class="vin__hint" id="vin-hint">17 знаків: латиниця і цифри, без I, O, Q</span></label>
        <span class="vin__count" role="status"><span data-vin-count>0</span>&nbsp;/&nbsp;17</span>
      </div>
      <div class="vin__field">
        <input
          id="vin-input" class="vin__input" name="vin" type="text" inputmode="text" maxlength="17"
          placeholder="17 знаків VIN" autocomplete="off" autocapitalize="characters" autocorrect="off" spellcheck="false"
          aria-describedby="vin-hint vin-error" data-vin-input
        />
        <ol class="vin__cells grid-17" aria-hidden="true">
          {cells.map((n) => (
            <li class="vin__cell" data-seg={segOf(n)} style={`--i:${n - 1}`}>
              <span class="vin__pos">{n}</span><span class="vin__char" data-cell></span>
            </li>
          ))}
        </ol>
        <div class="vin__ruler" aria-hidden="true">
          {groups.map((g) => (
            <span class="vin__group">
              {Array.from({ length: g.n }, () => <span class="vin__tick" data-tick style={`--i:${tick++}`}></span>)}
            </span>
          ))}
        </div>
      </div>

      <ol class="vin__scheme grid-17" aria-label="Схема VIN-коду">
        {vinSegments.map((s, i) => (
          <li class="vin__seg" data-seg={i} style={`grid-column:${s.from} / ${s.to + 1}`}>
            <span class="vin__seg-range">{s.from === s.to ? s.from : `${s.from}–${s.to}`}</span> {s.label}
          </li>
        ))}
      </ol>
      <ol class="vin__scheme-m" aria-label="Схема VIN-коду">
        {groups.map((g) => <li style={`flex:${g.n}`}>{g.label}</li>)}
      </ol>

      <p id="vin-error" class="vin__error" aria-live="polite" data-vin-error></p>
    </div>

    <div class="hero__actions">
      <a class="btn btn--white hero__send" href={vinMailto()} data-vin-send>
        <Icon name="mail" />Надіслати VIN менеджеру
      </a>
      <p class="hero__call">або подзвоніть <a class="link tel" href={`tel:${mainPhone.tel}`}>{mainPhone.display}</a></p>
    </div>
    <p class="hero__part">Знаєте номер деталі? <a class="link" href={partMailto}>Надішліть його листом</a></p>
  </div>
</section>

<script>
  import "../scripts/vin";
</script>

<style>
  .hero { background: var(--color-brand); color: var(--color-accent-ink); padding-block: var(--s-4) var(--s-4); }
  .hero__grid { row-gap: var(--s-3); align-items: end; }
  .hero__title { grid-column: 1 / -1; font-size: var(--fs-h1); line-height: var(--lh-display); color: var(--color-white); max-width: 18ch; }
  .hero__lead { grid-column: 1 / -1; color: var(--color-white); max-width: 40ch; font-size: clamp(1.0625rem, 0.9rem + 0.55vw, 1.375rem); line-height: 1.45; }

  .vin { grid-column: 1 / -1; margin-top: var(--s-1); }
  .vin__top { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-2); margin-bottom: var(--s-1); }
  .vin__label { font-weight: var(--fw-semi); }
  .vin__hint { display: block; font-weight: var(--fw-regular); font-size: var(--fs-small); color: var(--color-on-brand-soft); }
  @media (min-width: 768px) { .vin__hint { display: inline; margin-left: var(--s-1); } }
  .vin__field { position: relative; }
  .vin__input {
    width: 100%; height: 56px; padding: 0 16px; border: 0; border-radius: var(--radius);
    background: var(--color-white); color: var(--color-ink);
    font: var(--fw-semi) 1.375rem/1 var(--font-display); letter-spacing: 0.04em;
  }
  .vin__input:focus-visible { outline: 2px solid var(--color-focus-inverse); outline-offset: 3px; }
  .vin__input::placeholder { color: var(--color-line-ui); font-family: var(--font-body); font-weight: var(--fw-regular); font-size: 1rem; letter-spacing: 0; }

  .grid-17 { display: grid; grid-template-columns: repeat(17, minmax(0, 1fr)); column-gap: var(--gutter); }
  .vin__cells { display: none; }

  .vin__ruler { display: flex; gap: 12px; margin-top: 12px; }
  .vin__group { flex: var(--n, 1); display: flex; justify-content: space-between; }
  .vin__group:nth-child(1) { flex: 3; } .vin__group:nth-child(2) { flex: 6; } .vin__group:nth-child(3) { flex: 8; }
  .vin__tick { width: 2px; height: 12px; background: var(--color-on-brand-soft); opacity: 0.55; transform-origin: bottom; transition: opacity var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out); }
  .vin__tick.is-filled { opacity: 1; transform: scaleY(1.6); background: var(--color-white); }

  .vin__scheme { display: none; }
  .vin__scheme-m { display: flex; gap: 12px; margin-top: 8px; font-size: 0.75rem; line-height: 1.3; color: var(--color-on-brand-soft); }
  .vin__scheme-m li { min-width: 0; }

  .vin__count { font-size: var(--fs-small); color: var(--color-on-brand-soft); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .vin__error { min-height: 1.45em; margin-top: var(--s-1); font-size: var(--fs-small); font-weight: var(--fw-semi); color: var(--color-white); }

  .hero__actions { grid-column: 1 / -1; display: flex; flex-direction: column; align-items: stretch; gap: var(--s-2); }
  .hero__send { width: 100%; }
  .hero__call, .hero__part { color: var(--color-on-brand-soft); }
  .hero__call .link, .hero__part .link { color: var(--color-white); font-weight: var(--fw-semi); }
  .hero__part { grid-column: 1 / -1; font-size: var(--fs-small); }

  /* Effect 1 on phones: the ruler ticks appear (opacity only). */
  .vin.is-assembling .vin__tick { animation: tick-in 300ms var(--ease-out) both; animation-delay: calc(var(--i) * 20ms); }
  @keyframes tick-in { from { opacity: 0; } }

  @media (min-width: 768px) {
    .hero { padding-block: var(--s-5); }
    .hero__actions { flex-direction: row; align-items: center; gap: var(--s-3); }
    .hero__send { width: auto; }
    .vin__input { height: 72px; font-size: 1.75rem; }
  }

  /* Cells mode: 17 cells mirror the one native input (needs JS; without it the plain input stays). */
  @media (min-width: 768px) {
    :global(.js) .vin__cells { display: grid; }
    :global(.js) .vin__ruler, :global(.js) .vin__scheme-m { display: none; }
    :global(.js) .vin__scheme { display: grid; }
    :global(.js) .vin__input {
      position: absolute; inset: 0; height: 100%; opacity: 0; z-index: 2; cursor: text;
      font-size: 16px; letter-spacing: 0; color: transparent; caret-color: transparent;
    }
    :global(.js) .vin__field:focus-within { outline: 2px solid var(--color-focus-inverse); outline-offset: 6px; border-radius: var(--radius); }
    :global(.js) .vin__field:has(.vin__input:focus:not(:focus-visible)) { outline: none; }
    :global(.js) .vin__field:has(.vin__input:focus) .vin__cell.is-active::after { opacity: 1; }
  }
  .vin__cell {
    position: relative; display: grid; place-items: center; height: clamp(64px, 5.6vw, 84px);
    background: var(--color-white); border-radius: var(--radius); color: var(--color-ink);
    transition: opacity 220ms var(--ease-out);
  }
  .vin__cell::after { content: ""; position: absolute; left: 18%; right: 18%; bottom: 10px; height: 3px; background: var(--color-brand); opacity: 0; }
  .vin__pos { position: absolute; font-size: 0.875rem; color: var(--color-line-ui); font-variant-numeric: tabular-nums; }
  .vin__cell.is-filled .vin__pos { top: 6px; left: 8px; font-size: 0.6875rem; }
  .vin__char { font: var(--fw-semi) clamp(1.75rem, 0.6rem + 2.3vw, 2.75rem)/1 var(--font-display); }
  .vin__cell.is-pop .vin__char { animation: char-in 200ms var(--ease-out); }
  @keyframes char-in { from { transform: scale(.92); opacity: .4; } }
  .vin.is-assembling .vin__cell { animation: cell-in var(--dur-cell) var(--ease-out) both; animation-delay: calc(var(--i) * 25ms); }
  @keyframes cell-in { from { opacity: 0; transform: translateY(8px); } }
  .vin[data-hover-seg] .vin__cell.is-dim { opacity: .5; }

  .vin__scheme { margin-top: 12px; font-size: var(--fs-small); line-height: 1.3; color: var(--color-on-brand-soft); }
  .vin__seg { position: relative; padding-top: 16px; min-width: 0; overflow-wrap: break-word; cursor: default; transition: color var(--dur-fast) var(--ease-out); }
  .vin__seg::before { content: ""; position: absolute; top: 0; left: 0; right: 0; height: 8px; border: 1px solid currentColor; border-top: 0; border-radius: 0 0 2px 2px; opacity: .7; }
  .vin__seg-range { display: block; font-family: var(--font-display); font-weight: var(--fw-semi); }
  .vin__seg.is-active { color: var(--color-white); }

  @media (min-width: 1200px) {
    .hero { min-height: calc(100svh - var(--header-h)); display: flex; align-items: center; padding-block: var(--s-4); }
    .hero__grid { width: min(100% - 2 * var(--page-pad), var(--container)); }
    .hero__title { grid-column: 1 / span 11; max-width: none; }
    .hero__lead { grid-column: 12 / -1; align-self: end; padding-left: var(--s-3); border-left: 2px solid var(--color-on-brand-soft); }
    .vin { margin-top: var(--s-3); }
  }

  @media (prefers-reduced-motion: reduce) {
    .vin.is-assembling .vin__cell, .vin.is-assembling .vin__tick, .vin__cell.is-pop .vin__char { animation: none; }
    .vin__cell, .vin__tick { transition: none; }
  }
</style>
