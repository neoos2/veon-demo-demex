---
// Small line icons (inline SVG, decorative: the text next to them carries the meaning).
interface Props { name: "phone" | "mail" | "search" | "menu" | "close" | "pin" | "chevron"; class?: string; }
const { name, class: cls } = Astro.props;
const paths: Record<Props["name"], string> = {
  phone: "M6.6 3h3l1.5 4.5-2.1 1.4a12 12 0 0 0 6.1 6.1l1.4-2.1L21 14.4v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.6 5.2 2 2 0 0 1 6.6 3z",
  mail: "M3 6h18v12H3zM3 6l9 7 9-7",
  search: "M10.5 17a6.5 6.5 0 1 0 0-13 6.5 6.5 0 0 0 0 13zM15.5 15.5 20 20",
  menu: "M4 7h16M4 12h16M4 17h16",
  close: "M6 6l12 12M18 6 6 18",
  pin: "M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15 12 21 12 21zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z",
  chevron: "M6 9l6 6 6-6",
};
---
<svg class:list={["icon", cls]} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={paths[name]} /></svg>
